{
	"mode": "dock",
	"position": "top",
	"layer": "top",
	"width": 0,
	"height": 0,
	"margin": 0,
	"spacing": 0,
	"reload_style_on_change": true,

	"include": [
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/hyprland/*.jsonc",
		"~/.config/waybar/modules/*.jsonc"
	],

	"modules-left": [
		"custom/user",

		"custom/right#inverse",
		"hyprland/workspaces",
		"custom/right",

        "custom/right#inverse",
        "cpu",
        "memory",
        "temperature",
        "power-profiles-daemon",
        "custom/right",

        "mpris"
	],

	"modules-right": [
        "tray",

		"custom/left",
		"group/pulseaudio",
		// "bluetooth",
		"network",
		"battery",
        "custom/left#inverse",

        "custom/left",
        "clock#date",
        "custom/left#inverse",

        "custom/left#accent",
		"clock#time",
		"custom/left#inverse-accent",

		"custom/power"
	]
}
