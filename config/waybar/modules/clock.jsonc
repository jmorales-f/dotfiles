{
	"clock#time": {
		"format": "{:%H:%M}",
		"min-length": 5,
		"max-length": 5,
		"tooltip-format": "<b>Standard Time</b>: <span text_transform='lowercase'>{:%I:%M %p}</span>"
	},

	"clock#date": {
		"format": "{:%a %d/%m}",
		"min-length": 12,
		"max-length": 12,
		"actions": {
			"on-click": "mode"
		},

		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"format": {
				"months": "<span alpha='100%'><b>{}</b></span>",
				"days": "<span alpha='85%'>{}</span>",
				"weekdays": "<span alpha='60%'><i>{}</i></span>",
				"today": "<span color='#c4a7e7' alpha='100%'><b><u>{}</u></b></span>"
			}
		},

		"tooltip-format": "{calendar}"
	}
}
