# For defaults and description of each option, see the link bellow
# https://github.com/dunst-project/dunst/blob/master/dunstrc

[global]
# Display
follow = mouse
width = 400
height = (0, 300)
origin = bottom-right
offset = (15, 15)
indicate_hidden = yes
notification_limit = 5
gap_size = 12
padding = 15
horizontal_padding = 15
frame_width = 1
sort = no

# Progress bar
progress_bar_frame_width = 0
progress_bar_corner_radius = 3

# Colors
foreground = "#e0def4"
background = "#1f1d2e"
highlight = "#c4a7e7"

# Text
font = CaskaydiaCove Nerd Font 10
markup = full
format = "<small>%a</small>\n<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = -1
hide_duplicate_count = false

# Icon
icon_position = left
min_icon_size = 64
max_icon_size = 64
icon_path = /usr/share/icons/Arc/status/96:/usr/share/icons/Arc/status/symbolic
icon_corner_radius = 3

# Misc/Advanced
dmenu = rofi -dmenu -p 'Open with'

# Mouse
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
frame_color = "#6e6a8699"
timeout = 2

[urgency_normal]
frame_color = "#6e6a8699"
timeout = 5

[urgency_critical]
frame_color = "#eb6f9299"
highlight = "#eb6f92"
foreground = "#eb6f92"
timeout = 5

# Rules
[fullscreen_delay_everything]
fullscreen = delay

[fullscreen_show_critical]
msg_urgency = critical
fullscreen = show

[fullscreen_show_normal]
msg_urgency = normal
fullscreen = show
