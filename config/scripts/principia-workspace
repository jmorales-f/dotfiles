#!/usr/bin/env bash
#
# Toggle the Principia VS Code workspace in a scratchpad (special workspace).
#
# code's CLI just messages an already-running VS Code instance over IPC, so
# the window it opens is never a child of the process we spawn here -- a
# window rule or exec-time workspace assignment can't reliably catch it
# (the window's title is still generic at the moment Hyprland maps it, so a
# match-by-title static "workspace" rule loses the race). Instead: launch
# it, poll until the real window shows up, then move it explicitly.

set -euo pipefail

name="pws"
workspace_file="$HOME/dev/principia-workspace/principia.code-workspace"
title_match="principia (Workspace)"

if hyprctl -j clients | jq -e --arg ws "special:$name" \
    'any(.[]; .workspace.name == $ws)' >/dev/null; then
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$name\")"
    exit 0
fi

kitty -e code --new-window "$workspace_file" &

for _ in $(seq 1 50); do
    addr=$(hyprctl -j clients | jq -r --arg t "$title_match" \
        '[.[] | select(.class == "code-oss" and (.title | contains($t)))][0].address // empty')
    if [[ -n "$addr" ]]; then
        # A silent move into a special workspace already shows it -- no
        # separate toggle_special call needed (that would just hide it again).
        hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:$name\", window = \"address:$addr\", silent = true })"
        exit 0
    fi
    sleep 0.1
done

notify-send -a "System" "Principia workspace" "Timed out waiting for the VS Code window" -u critical
exit 1
