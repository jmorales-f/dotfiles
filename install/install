	#!/bin/bash

	set -euo pipefail
	IFS=$'\n\t'

	# --- Configuration ---
	CONFIG_DIR="$HOME/.config"
	DOTFILES_REPO="$HOME/dev/dotfiles" # Assuming dotfiles are here
	PACMAN_PACKAGES_FILE="packages_pacman.txt"
	YAY_PACKAGES_FILE="packages_yay.txt"
	NPM_PACKAGES_FILE="packages_npm.txt"
	UNNECESSARY_PACKAGES_FILE="unnecessary_packages.txt"

	# --- Logging ---
	log() {
	    echo -e "\033[1;32m[INFO]\033[0m $1"
	}

	warn() {
	    echo -e "\033[1;33m[WARN]\033[0m $1"
	}

	error() {
	    echo -e "\033[1;31m[ERROR]\033[0m $1" >&2
	}

	# --- Helper Functions ---
	run_cmd() {
	    log "Running: $*"
	    if "$@"; then
		log "Successfully ran: $*"
	    else
		error "Failed to run: $*"
		exit 1
	    fi
	}

	create_symlink() {
	    local src="$1"
	    local dest="$2"
	    if [ -e "$dest" ] || [ -L "$dest" ]; then
		warn "Removing existing $dest"
		run_cmd rm -rf "$dest"
	    fi
	    log "Creating symlink from $src to $dest"
	    run_cmd ln -sf "$src" "$dest"
	}

	# --- Installation Modules ---

	install_core_packages() {
	    log "Updating system and installing core packages via pacman..."
	    run_cmd sudo pacman -Syu --noconfirm

	    if [ ! -f "$PACMAN_PACKAGES_FILE" ]; then
		error "Pacman packages file not found: $PACMAN_PACKAGES_FILE"
		exit 1
	    fi
    local pacman_packages
    readarray -t pacman_packages < "$PACMAN_PACKAGES_FILE"

    if [ ${#pacman_packages[@]} -gt 0 ]; then
        run_cmd sudo pacman -S --noconfirm "${pacman_packages[@]}"
    else
        warn "No pacman packages listed in $PACMAN_PACKAGES_FILE"
    fi
}

remove_unnecessary_packages() {
    log "Removing unnecessary packages..."
    if [ ! -f "$UNNECESSARY_PACKAGES_FILE" ]; then
        error "Unnecessary packages file not found: $UNNECESSARY_PACKAGES_FILE"
        exit 1
    fi

    local unnecessary_packages
    readarray -t unnecessary_packages < "$UNNECESSARY_PACKAGES_FILE"

    for pkg in "${unnecessary_packages[@]}"; do
        if pacman -Qq "$pkg" &> /dev/null; then
            run_cmd sudo pacman -R --noconfirm "$pkg"
        else
            warn "$pkg not found, skipping removal."
        fi
    done
}

setup_docker() {
    log "Setting up Docker..."
    run_cmd sudo usermod -aG docker "$USER"
    run_cmd sudo systemctl enable --now docker
}

enable_system_services() {
    log "Enabling system services..."
    run_cmd sudo systemctl enable --now bluetooth
    # run_cmd systemctl --user enable --now hypridle.service
}

set_default_shell() {
    log "Setting ZSH as default shell..."
    local zsh_path
    zsh_path=$(which zsh)

    if grep -q "^$zsh_path$" /etc/shells; then
        if [ "$(basename "$SHELL")" != "zsh" ]; then
            run_cmd chsh -s "$zsh_path"
            log "Please log out and back in for the shell change to take effect."
        else
            log "ZSH is already the default shell."
        fi
    else
        warn "ZSH ($zsh_path) is not listed in /etc/shells. Cannot set ZSH as default using chsh."
    fi
}

install_yay_helper() {
    if ! command -v yay &> /dev/null; then
        log "Installing yay (AUR helper)..."
        local yay_dir="yay-bin"
        run_cmd git clone https://aur.archlinux.org/yay-bin.git "$yay_dir"
        (cd "$yay_dir" && run_cmd makepkg -si --noconfirm)
        run_cmd rm -rf "$yay_dir"
    else
        log "yay is already installed."
    fi
}

install_aur_packages() {
    if ! command -v yay &> /dev/null; then
        error "yay is not installed. Cannot install AUR packages."
        return 1
    fi

    log "Installing AUR packages via yay..."
    if [ ! -f "$YAY_PACKAGES_FILE" ]; then
        error "Yay packages file not found: $YAY_PACKAGES_FILE"
        exit 1
    fi

    local yay_packages
    readarray -t yay_packages < "$YAY_PACKAGES_FILE"

    if [ ${#yay_packages[@]} -gt 0 ]; then
        run_cmd yay -S --noconfirm "${yay_packages[@]}"
    else
        warn "No yay packages listed in $YAY_PACKAGES_FILE"
    fi
}

install_npm_packages() {
    log "Installing global NPM packages..."
    if [ ! -f "$NPM_PACKAGES_FILE" ]; then
        error "NPM packages file not found: $NPM_PACKAGES_FILE"
        exit 1
    fi

    local npm_packages
    readarray -t npm_packages < "$NPM_PACKAGES_FILE"

    if [ ${#npm_packages[@]} -gt 0 ]; then
        run_cmd npm install -g "${npm_packages[@]}"
    else
        warn "No NPM packages listed in $NPM_PACKAGES_FILE"
    fi
}

install_npm() {
    log "Installing Node.js via NVM..."
    local nvm_install_script
    nvm_install_script=$(curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh)
    bash -c "$nvm_install_script"
    # Source NVM for the current shell to use it immediately
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
    if command -v nvm &> /dev/null; then
        run_cmd nvm install 22
        run_cmd node -v
    else
        error "NVM did not install correctly. Node.js not installed."
    fi
}

setup_user_services() {
    log "Setting up user-specific services..."

    log "Setting up Docker Notify..."
    local docker_notify_service_src="$DOTFILES_REPO/config/systemd/user/docker-notify.service"
    local docker_notify_service_dest="$CONFIG_DIR/systemd/user/docker-notify.service"
    local docker_notify_script="$DOTFILES_REPO/config/systemd/scripts/docker_notify.sh"
    if [ -f "$docker_notify_service_src" ] && [ -f "$docker_notify_script" ]; then
        run_cmd mkdir -p "$(dirname "$docker_notify_service_dest")" "$CONFIG_DIR/systemd/scripts"
        run_cmd ln -sf "$docker_notify_service_src" "$docker_notify_service_dest"
        run_cmd ln -sf "$docker_notify_script" "$CONFIG_DIR/systemd/scripts/docker_notify.sh"
        run_cmd chmod +x "$docker_notify_script"
        run_cmd systemctl --user enable --now docker-notify.service
    else
        error "Docker Notify service or script not found. Skipping setup."
    fi


    log "Setting up SSH Agent and SSH Add services..."
    local ssh_agent_service_src="$DOTFILES_REPO/config/systemd/user/ssh-agent.service"
    local ssh_add_service_src="$DOTFILES_REPO/config/systemd/user/ssh-add.service"
    local ssh_agent_service_dest="$CONFIG_DIR/systemd/user/ssh-agent.service"
    local ssh_add_service_dest="$CONFIG_DIR/systemd/user/ssh-add.service"

    run_cmd mkdir -p "$(dirname "$ssh_agent_service_dest")"

    if [ -f "$ssh_agent_service_src" ]; then
        create_symlink "$ssh_agent_service_src" "$ssh_agent_service_dest"
        run_cmd systemctl --user enable --now ssh-agent.service
    else
        error "SSH Agent service file not found: $ssh_agent_service_src. Skipping setup."
    fi

     if [ -f "$ssh_add_service_src" ]; then
        create_symlink "$ssh_add_service_src" "$ssh_add_service_dest"
        run_cmd systemctl --user enable --now ssh-add.service
    else
        error "SSH Add service file not found: $ssh_add_service_src. Skipping setup."
    fi


    log "Setting up Waybar auto-restart and Hyprland session target..."
    local waybar_service_src="$DOTFILES_REPO/config/systemd/user/waybar.service"
    local waybar_service_dest="$CONFIG_DIR/systemd/user/waybar.service"
    local hyprland_session_target_src="$DOTFILES_REPO/config/systemd/user/hyprland-session.target"
    local hyprland_session_target_dest="$CONFIG_DIR/systemd/user/hyprland-session.target"

    if [ -f "$waybar_service_src" ]; then
        create_symlink "$waybar_service_src" "$waybar_service_dest"
        run_cmd systemctl --user enable waybar.service
    else
        error "Waybar service file not found: $waybar_service_src. Skipping setup."
    fi

    if [ -f "$hyprland_session_target_src" ]; then
        create_symlink "$hyprland_session_target_src" "$hyprland_session_target_dest"
    else
        error "Hyprland session target not found: $hyprland_session_target_src. Skipping setup."
    fi
}


setup_dotfiles() {
    log "Setting up dotfiles via symlinks..."

    # Ensure config directory exists
    run_cmd mkdir -p "$CONFIG_DIR"
    run_cmd mkdir -p "$CONFIG_DIR/systemd/user"

    # array of source-destination pairs (src:dest)
    declare -A symlinks=(
        ["$DOTFILES_REPO/config/zsh"]="$CONFIG_DIR/zsh"
        ["$DOTFILES_REPO/config/zsh/.zshrc"]="$HOME/.zshrc"
        ["$DOTFILES_REPO/config/starship/starship.toml"]="$CONFIG_DIR/starship.toml"
        ["$DOTFILES_REPO/config/opencode/AGENTS.md"]="$CONFIG_DIR/opencode/AGENTS.md"
        ["$DOTFILES_REPO/config/opencode/skills"]="$CONFIG_DIR/opencode/skills"
        ["$DOTFILES_REPO/config/nvim"]="$CONFIG_DIR/nvim"
        ["$DOTFILES_REPO/config/kitty"]="$CONFIG_DIR/kitty"
        ["$DOTFILES_REPO/config/zellij"]="$CONFIG_DIR/zellij"
        ["$DOTFILES_REPO/config/btop"]="$CONFIG_DIR/btop"
        ["$DOTFILES_REPO/config/atuin"]="$CONFIG_DIR/atuin"
        ["$DOTFILES_REPO/config/rofi"]="$CONFIG_DIR/rofi"
        ["$DOTFILES_REPO/config/hypr"]="$CONFIG_DIR/hypr"
        ["$DOTFILES_REPO/config/waybar"]="$CONFIG_DIR/waybar"
        ["$DOTFILES_REPO/config/dunst"]="$CONFIG_DIR/dunst"
        ["$DOTFILES_REPO/config/scripts"]="$CONFIG_DIR/scripts"
        ["$DOTFILES_REPO/config/menu"]="$CONFIG_DIR/menu"
    )

    for src in "${!symlinks[@]}"; do
        dest="${symlinks[$src]}"
        # Check if source exists before creating symlink
        if [ -e "$src" ]; then
            create_symlink "$src" "$dest"
        else
            warn "Source file/directory not found for symlink: $src. Skipping."
        fi
    done

    log "Copying wallpapers to ~/wallpapers..."
    if [ -d "$DOTFILES_REPO/wallpapers" ]; then
        mkdir -p "$HOME/wallpapers"
        cp -rn "$DOTFILES_REPO/wallpapers/." "$HOME/wallpapers/"
    else
        warn "Wallpapers directory not found: $DOTFILES_REPO/wallpapers. Skipping."
    fi

    log "Dotfiles setup complete!"
}

# --- Main Execution ---
main() {
    log "Starting dotfiles and system setup script..."

    install_core_packages
    setup_docker
    enable_system_services
    set_default_shell
    install_yay_helper
    install_npm
    install_aur_packages
    install_npm_packages
    setup_user_services
    setup_dotfiles

    log "All setup steps completed!"
    log "Please consider logging out and back in for changes to take effect (especially shell changes and Docker group membership)."
}

main
